# Copy to ".env" for local dev, or set these as build-time env in your host
# (GitHub Pages: repo Secrets). Both are required to turn on cross-device sync.
# When either is missing, the app runs in localStorage-only mode.
#
# These are PUBLIC values (the anon key is designed to be shipped in the client
# and is protected by Row Level Security). NEVER put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
